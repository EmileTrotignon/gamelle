; Headless screenshot comparison tests: render a scene with both the raylib and
; the browser backend, then promote a side-by-side and an odiff into the source
; tree. Nothing here is built by default (a normal `dune build`/CI must not need
; xvfb or geckodriver); each test is opt-in via its alias.
;
;   dune build @compare_lines        --auto-promote  ; lines, default font
;   dune build @compare_glyph        --auto-promote  ; two glyphs, default font
;   dune build @compare_roboto       --auto-promote  ; lines, Roboto (proportional)
;   dune build @compare_roboto_glyph --auto-promote  ; two glyphs, Roboto
;
; `dune runtest` asserts that both backends predict the same text sizes (via the
; public Text.size / Text.size_multiline) — see the size-assertion rules below.
;
; Both backends share one entry point each: the native [main] takes the scenario
; as an argument; the browser [dump_js] derives it from the page filename. Native
; and browser must be separate executables because gamelle.raylib has C stubs and
; cannot compile to js.

; One module per scenario (lines, glyph, roboto, roboto_glyph) plus shared
; infrastructure in [common]. Embeds the Roboto font (via ppx_blob).

; One page per scenario, all loading the same dump_js.bc.js; the js picks its
; scenario from the page filename.

(rule
 (alias draw_screenshot)
 (targets compare.png diff.png raylib.png jsoo.png)
 (mode promote)
 (deps
  screenshot.sh
  basic/basic_bin.exe
  basic/basic.html
  (file %{project_root}/test/cram/screenshot/screenshot.exe)
  (file %{project_root}/data/FreeMono.ttf)
  (file %{project_root}/test/raylib_screenshot.sh))
 (action
  (run
   bash
   screenshot.sh
   basic/basic_bin.exe
   basic/basic.html
   %{project_root}/test/cram/screenshot/screenshot.exe
   %{project_root}/data/FreeMono.ttf
   %{project_root}/test/raylib_screenshot.sh
   4444)))

; The clipping scene, kept separate from the basic drawing scene. Same pipeline,
; a distinct output prefix (so both scenes' images coexist here) and its own
; geckodriver port for parallel-safe runs.
;
;   dune build @draw_screenshot_clip --auto-promote

(rule
 (alias draw_screenshot_clip)
 (targets clip_compare.png clip_diff.png clip_raylib.png clip_jsoo.png)
 (mode promote)
 (deps
  screenshot.sh
  clip/clip_bin.exe
  clip/clip.html
  (file %{project_root}/test/cram/screenshot/screenshot.exe)
  (file %{project_root}/data/FreeMono.ttf)
  (file %{project_root}/test/raylib_screenshot.sh))
 (action
  (run
   bash
   screenshot.sh
   clip/clip_bin.exe
   clip/clip.html
   %{project_root}/test/cram/screenshot/screenshot.exe
   %{project_root}/data/FreeMono.ttf
   %{project_root}/test/raylib_screenshot.sh
   ; Unique port per parallel screenshot rule: it is both the geckodriver port and
   ; (minus 4344) the Xvfb display number. test/text uses 4445-4449 and basic above
   ; uses 4444, so clip must sit outside that range — 4445 collided with test/text's
   ; `lines` rule on both, giving "Session is already started" / "Xvfb failed to
   ; start" when they ran in parallel.
   4450
   clip_)))

; The SVG scene: draw the same vector logo plain, under a rotated view, and
; under a clip, so the raylib (nanosvg-rasterised) and browser (native SVG)
; renderings can be compared. Same pipeline, its own output prefix and port.
;
;   dune build @draw_screenshot_svg --auto-promote

(rule
 (alias draw_screenshot_svg)
 (targets svg_compare.png svg_diff.png svg_raylib.png svg_jsoo.png)
 (mode promote)
 (deps
  screenshot.sh
  svg/svg_scene_bin.exe
  svg/svg_scene.html
  (file %{project_root}/test/cram/screenshot/screenshot.exe)
  (file %{project_root}/data/FreeMono.ttf)
  (file %{project_root}/test/raylib_screenshot.sh))
 (action
  (run
   bash
   screenshot.sh
   svg/svg_scene_bin.exe
   svg/svg_scene.html
   %{project_root}/test/cram/screenshot/screenshot.exe
   %{project_root}/data/FreeMono.ttf
   %{project_root}/test/raylib_screenshot.sh
   ; Unique port (see the clip rule above): outside test/text's 4445-4449, basic's
   ; 4444 and clip's 4450.
   4451
   svg_)))

; The defs/use SVG scene: draw an SVG whose foreground art lives in <defs> and is
; instantiated with <use> (exactly how the SWF->SVG exporter emits it). The
; browser resolves <use> and draws the art; raylib's nanosvg does not, so only
; the background rect survives. This scene exists to reproduce that bug: the two
; renderings differ by the whole foreground. Same pipeline, its own port/prefix.
;
;   dune build @draw_screenshot_defs_use --auto-promote

(rule
 (alias draw_screenshot_defs_use)
 (targets
  defs_use_compare.png
  defs_use_diff.png
  defs_use_raylib.png
  defs_use_jsoo.png)
 (mode promote)
 (deps
  screenshot.sh
  defs_use/defs_use_bin.exe
  defs_use/defs_use.html
  (file %{project_root}/test/cram/screenshot/screenshot.exe)
  (file %{project_root}/data/FreeMono.ttf)
  (file %{project_root}/test/raylib_screenshot.sh))
 (action
  (run
   bash
   screenshot.sh
   defs_use/defs_use_bin.exe
   defs_use/defs_use.html
   %{project_root}/test/cram/screenshot/screenshot.exe
   %{project_root}/data/FreeMono.ttf
   %{project_root}/test/raylib_screenshot.sh
   ; Unique port (see the clip rule above): outside test/text's 4445-4449, basic's
   ; 4444, clip's 4450 and svg's 4451.
   4452
   defs_use_)))

(cram
 (package gamelle)
 (deps
  raylib.png
  jsoo.png
  clip_raylib.png
  clip_jsoo.png
  svg_raylib.png
  svg_jsoo.png
  defs_use_raylib.png
  defs_use_jsoo.png))
